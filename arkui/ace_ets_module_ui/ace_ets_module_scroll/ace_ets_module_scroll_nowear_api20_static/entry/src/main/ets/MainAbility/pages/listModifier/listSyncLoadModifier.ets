// 定义 syncLoad 的 Modifier 类
@Observed
export class ListSyncLoadModifier implements AttributeModifier<ListAttribute> {
  private syncValue: boolean | undefined;

  constructor(sync: boolean | undefined) {
    this.syncValue = sync;
  }

  applyNormalAttribute(instance: ListAttribute): void {
    instance.syncLoad(this.syncValue);
  }
}

@Entry
@Component
struct ListSyncLoadModifierExample {
  private data: number[] = (() => {
    let arr: number[] = [];
    for (let i = 1; i <= 30; i++) {
      arr.push(i);
    }
    return arr;
  })();
  // 创建 Modifier 实例
  @State private trueModifier: ListSyncLoadModifier = new ListSyncLoadModifier(true);
  @State private falseModifier: ListSyncLoadModifier = new ListSyncLoadModifier(false);
  @State private undefinedModifier: ListSyncLoadModifier = new ListSyncLoadModifier(undefined);
  @Builder
  private ListWithSyncLoadModifier(modifier: AttributeModifier<ListAttribute>, tip: string, id: number) {
    Column() {
      Text(tip).fontSize(14).fontColor(Color.Gray)
      List() {
        ForEach(this.data, (i: number) => {
          ListItem() {
            Image($r('app.media.startIcon'))
              .width(60)
              .height(60)
              .border({ width: 1, color: Color.Gray })
          }
        }, (i: number) => i.toString())
      }
      .id(`listSyncLoadModifier_00${id}`)
      .attributeModifier(modifier)  // 使用 attributeModifier
      .width('100%')
      .height(400)
      .backgroundColor(0xFFF8F0)
    }
    .width('100%')
    .alignItems(HorizontalAlign.Start)
  }

  build() {
    Scroll() {
      Column() {
        Text('syncLoad 测试总览 (Modifier方式)')
          .fontSize(20).fontWeight(FontWeight.Bold)
        this.ListWithSyncLoadModifier(this.trueModifier, '正常值：true', 1)
        this.ListWithSyncLoadModifier(this.falseModifier, '正常值：false', 2)
        this.ListWithSyncLoadModifier(this.undefinedModifier, '显式 undefined', 3)

      }
      .padding(16)
    }
    .width('100%')
    .height('100%')
  }
}