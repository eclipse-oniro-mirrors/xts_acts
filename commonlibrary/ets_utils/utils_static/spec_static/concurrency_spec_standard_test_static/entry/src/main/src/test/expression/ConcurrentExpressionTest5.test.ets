        let caseName = 'concurrent_ExpressionTest0741'
        let result: int = 0
        
        try {
          let group = new taskpool.TaskGroup(caseName)
          for (let i: int = 0; i < concurrentNum; i++) {
            group.addTask(ExpressionTest0741)
          }
