import { huks } from '@kit.UniversalKeystoreKit';
import { GenParam } from './HuksOptionsUtils';

export function GetImportPubKeyOptions(): huks.HuksOptions {
  let huksOptions: huks.HuksOptions = {
    properties: new Array(
      GenParam(huks.HuksTag.HUKS_TAG_IMPORT_KEY_TYPE, huks.HuksImportKeyType.HUKS_KEY_TYPE_PUBLIC_KEY)
    ),
  };
  return huksOptions;
}

export function GetImportPriKeyOptions(): huks.HuksOptions {
  let huksOptions: huks.HuksOptions = {
    properties: new Array(
      GenParam(huks.HuksTag.HUKS_TAG_IMPORT_KEY_TYPE, huks.HuksImportKeyType.HUKS_KEY_TYPE_PRIVATE_KEY)
    ),
  };
  return huksOptions;
}

export function GetImportKeyPairOptions(): huks.HuksOptions {
  let huksOptions: huks.HuksOptions = {
    properties: new Array(
      GenParam(huks.HuksTag.HUKS_TAG_IMPORT_KEY_TYPE, huks.HuksImportKeyType.HUKS_KEY_TYPE_KEY_PAIR)
    ),
  };
  return huksOptions;
}

