{
  "description": "Config for ActsHuksNapiTest cases",
  "driver": {
    "type": "OHJSUnitTest",
    "test-timeout": "1200000",
    "shell-timeout": "1200000",
    "bundle-name": "com.example.actshuksnapitest",
    "module-name": "entry_test",
    "testcase-timeout": 1200000
  },
  "kits": [
    {
      "test-file-name": [
        "ActsHuksNapiMainTest.hap",
        "ActsHuksNapiHapTest.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    },
    {
      "type": "ShellKit",
      "run-command": [
        "power-shell wakeup",
        "power-shell setmode 602"
      ]
    }
  ]
}