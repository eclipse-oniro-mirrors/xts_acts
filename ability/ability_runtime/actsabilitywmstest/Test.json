{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "180000",
        "shell-timeout": "180000",
        "bundle-name": "com.acts.actsabilitywmstest",
        "module-name": "entry_test",
        "testcase-timeout": "10000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsAbilityWMSTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "ShellKit",
            "run-command": [
                "uitest dumpLayout",
                "power-shell wakeup",
                "uinput -T -m 300 1279 280 200",
                "uinput -T -d 300 600 -u 300 100",
                "power-shell timeout -o 86400000",
                "power-shell setmode 602"
            ]
        }
    ]
}