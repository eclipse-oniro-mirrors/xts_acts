{
  "module": {
    "name": "entry",
    "type": "entry",
    "srcEntry": "./ets/Application/MyAbilityStage.ets",
    "description": "$string:entry_desc",
    "mainElement": "MainAbility",
    "deviceTypes": [],
    "appStartup": "$profile:startup_config",
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "MainAbility",
        "srcEntry": "./ets/MainAbility/MainAbility.ets",
        "description": "$string:MainAbility_desc",
        "icon": "$media:icon",
        "label": "$string:MainAbility_label",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ],
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background"
      },
      {
        "name": "SingleStartAbility",
        "srcEntry": "./ets/MainAbility/SingleStartAbility.ets",
        "description": "$string:MainAbility_desc",
        "icon": "$media:icon",
        "label": "$string:MainAbility_label",
        "startWindowIcon": "$media:icon",
        "exported": true,
        "startWindowBackground": "$color:start_window_background"
      },
      {
        "name": "PageAbility2",
        "srcEntry": "./ets/MainAbility/PageAbility2.ets",
        "description": "$string:MainAbility_desc",
        "icon": "$media:icon",
        "label": "$string:MainAbility_label",
        "startWindowIcon": "$media:icon",
        "exported": true,
        "startWindowBackground": "$color:start_window_background",
      },
      {
        "name": "PageAbility11",
        "srcEntry": "./ets/MainAbility/PageAbility11.ets",
        "description": "$string:MainAbility_desc",
        "icon": "$media:icon",
        "label": "$string:MainAbility_label",
        "startWindowIcon": "$media:icon",
        "exported": true,
        "startWindowBackground": "$color:start_window_background",
      }
    ]
  }
}