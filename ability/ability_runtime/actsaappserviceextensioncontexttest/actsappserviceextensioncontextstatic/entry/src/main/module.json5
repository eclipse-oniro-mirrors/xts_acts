{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }

        ]
      },      
      {
        "name": "MyUIAbility2",
        "srcEntry": "./test/myuiability/MyUIAbility2.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "exported": true,
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background"
      }
    ],
    "extensionAbilities": [
      {
        "name": "AppServiceExtAbility",
        "srcEntry": "./ets/entryability/AppServiceExtAbility.ets",
        "type": "appService",
        "exported": true,
        "description": "appService",

      },
      {
        "name": "MyUIAbility",
        "srcEntry": "./test/myuiability/MyUIAbility.ets",
        "type": "embeddedUI",
        "exported": true
      },
      {
        "name": "AppServiceExtAbility2",
        "srcEntry": "./ets/entryability/AppServiceExtAbility2.ets",
        "type": "appService",
        "exported": true
      },
      {
        "name": "ServiceExtensionAbility",
        "srcEntry": "./ets/entryability/ServiceExtAbility.ets",
        "type": "service",
        "exported": true
      },
      {
        "name": "AppServiceExtAbility3",
        "srcEntry": "./ets/entryability/AppServiceExtAbility3.ets",
        "exported": true,
        "type": "appService",
        "permissions": [
          "ohos.permission.USE_BLUETOOTH"
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.SUPPORT_APP_SERVICE_EXTENSION"
      },
      {
        "name": "ohos.permission.START_ABILITIES_FROM_BACKGROUND"
      }
    ]
  }
}