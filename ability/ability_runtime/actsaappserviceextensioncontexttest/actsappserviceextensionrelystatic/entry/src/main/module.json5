 {
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      },
      {
        "name": "MainAbility",
        "srcEntry": "./ets/myuiability/MainAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ],
        "startWindowIcon": "$media:layered_image",
        "startWindowBackground": "$color:start_window_background"
      },      
      {
        "name": "EntryAbility2",
        "srcEntry": "./test/entryability/EntryAbility2.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": false
      }
    ],
    "extensionAbilities": [
      {
        "name": "AppServiceExtAbility",
        "srcEntry": "./ets/AppServiceExtension/AppServiceExtAbility.ets",
        "type": "appService",
        "exported": false
      },
      {
        "name": "AppServiceExtAbility2",
        "srcEntry": "./ets/AppServiceExtension/AppServiceExtAbility2.ets",
        "type": "appService",
        "appIdentifierAllowList": [
          "5765880207853134822",
          "5765880207852917075"
        ],
        "exported": true
      },
      {
        "name": "AppServiceExtAbility3",
        "srcEntry": "./ets/AppServiceExtension/AppServiceExtAbility3.ets",
        "exported": true,
        "type": "appService",
        "permissions": [
          "ohos.permission.USE_BLUETOOTH"
        ]
      },
      {
        "name": "ServiceExtAbility",
        "srcEntry": "./ets/ServiceExtension/ServiceExtAbility.ets",
        "type": "service",
        "exported": false
      },
      {
        "name": "MyUIAbility1",
        "srcEntry": "./ets/myuiability/MyUIAbility1.ets",
        "type": "embeddedUI",
        "exported": true
      },
      {
        "name": "MyUIAbility2",
        "srcEntry": "./est/myuiability/MyUIAbility2.ets",
        "type": "embeddedUI",
        "exported": true
      },
      {
        "name": "AgentExtAbility",
        "srcEntry": "./ets/AgentExtAbility/AgentExtAbility.ets",
       "type": "agent",
       "exported": true
     }
    ]
  }
}
